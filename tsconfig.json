{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next-f-migration-dev/types/**/*.ts",
    ".next-f-migration-dev/dev/types/**/*.ts",
    ".next-local-update-production-scheduled/types/**/*.ts",
    ".next-local-update-production-scheduled/dev/types/**/*.ts",
    ".next-amateur-actress-recovery-20261027/types/**/*.ts",
    ".next-amateur-actress-recovery-20261027/dev/types/**/*.ts",
    ".next-catalog-validation-20261031/types/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-bijyo-*",
    ".next-codex-*",
    ".next-fanza-*",
    ".next-local-push",
    ".next-xgrowth-*",
    ".next-f-migration-*",
    ".next-local-update-production",
    ".next-local-update-production/dev"
  ]
}
