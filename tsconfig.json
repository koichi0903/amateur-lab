{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-codex/types/**/*.ts",
    ".next-codex/dev/types/**/*.ts",
    ".next-xgrowth-dev-3003/types/**/*.ts",
    ".next-xgrowth-dev-3003/dev/types/**/*.ts",
    ".next-xgrowth-build/types/**/*.ts",
    ".next-xgrowth-build/dev/types/**/*.ts",
    ".next-xgrowth-verify-20260926/types/**/*.ts",
    ".next-xgrowth-verify-20260926/dev/types/**/*.ts",
    ".next-xgrowth-verify-20260926-2/types/**/*.ts",
    ".next-xgrowth-verify-20260926-2/dev/types/**/*.ts",
    ".next-codex-3002/types/**/*.ts",
    ".next-codex-3002/dev/types/**/*.ts",
    ".next-local-update-production/types/**/*.ts",
    ".next-local-update-production/dev/types/**/*.ts",
  ],
  "exclude": [
    "node_modules"
  ]
}
