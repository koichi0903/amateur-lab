{
  "manifest_version": 3,
  "name": "Myfans Companion for amateur-lab",
  "version": "0.1.36",
  "description": "Send the currently viewed myfans affiliate/product page to amateur-lab.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "alarms"],
  "host_permissions": ["https://*.myfans.jp/*", "https://*.affiliate.myfans.jp/*", "https://x.com/*", "https://twitter.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/admin/myfans*",
        "http://127.0.0.1/admin/myfans*"
      ],
      "js": ["myfans-admin-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
