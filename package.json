{
  "name": "amateur-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-dev.ps1",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-dev.ps1",
    "verify:canonical": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-canonical.ps1",
    "dev:myfans": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-dev.ps1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:myfans-public-copy": "node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansPublicCopy.test.ts",
    "test:myfans-daily-transaction": "node scripts/test-myfans-daily-transaction-contract.mjs && node scripts/test-myfans-persistence-contract.mjs && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansDailySnapshotView.test.ts",
    "test:myfans-persistence": "node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansDailySnapshotView.test.ts",
    "test:myfans-source-text": "node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansSourceText.test.ts",
    "test:myfans-growth-loop": "node scripts/test-myfans-growth-loop-contract.mjs",
    "test:x-growth-semantic-diversity": "node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/xGrowthSemanticDiversity.test.ts",
    "test:scheduled-update": "node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/admin/scheduleRunStatus.test.ts && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/admin/endedSaleBatch.test.ts && node --test scripts/local-admin-update-helpers.test.mjs",
    "test:myfans-companion": "node scripts/test-myfans-companion.mjs && node scripts/test-myfans-batch-e2e.mjs && node scripts/test-myfans-companion-terminal-contract.mjs && node scripts/test-myfans-transaction-contract.mjs && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansCompanionErrors.test.ts && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansAuthorMatch.test.ts && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansQuoteRefreshSummary.test.ts && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansCompleteThread.test.ts && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansQuoteRefreshLifecycle.test.ts && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansQuoteRefreshStaleLifecycle.test.ts && node --experimental-strip-types --import ./scripts/register-native-ts-tests.mjs src/lib/myfansCollectionRotation.test.ts",
    "update:playwright:local": "node scripts/local-playwright-update.mjs",
    "update:local": "node scripts/local-admin-update.mjs",
    "schedule:0030": "node scripts/local-admin-update.mjs daily-0030",
    "schedule:1030": "node scripts/local-admin-update.mjs daily-1030",
    "schedule:tue-fri-1800": "node scripts/local-admin-update.mjs tue-fri-1800",
    "schedule:sunday-1800": "node scripts/local-admin-update.mjs sunday-1800",
    "schedule:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-scheduled-tasks.ps1",
    "schedule:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-windows-scheduled-tasks.ps1",
    "update:ranking": "tsx scripts/update-ranking.ts",
    "update:longhit": "tsx scripts/update-longhit.ts",
    "update:score": "tsx -r dotenv/config src/lib/admin/updateScore.ts dotenv_config_path=.env.local",
    "probe:amateur": "tsx -r dotenv/config scripts/probe-amateur-floor.ts dotenv_config_path=.env.local",
    "backfill:actresses": "tsx scripts/backfill-work-actresses.ts",
    "repair:price-periods": "tsx scripts/repair-price-periods.ts",
    "repair:all-price-periods": "tsx scripts/repair-price-periods.ts --all",
    "repair:invalid-prices": "tsx scripts/repair-invalid-price-data.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@sentry/nextjs": "^10.70.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.9",
    "playwright-core": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
